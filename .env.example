AGENT_SERVER_PORT=8787
# Zeabur/Docker can set PORT instead. If PORT exists it wins over AGENT_SERVER_PORT.
PORT=
EXPO_PUBLIC_AGENT_API_URL=http://localhost:8787

# Public RPCs used by web through the local server proxy and by native builds
# when no custom provider is configured.
EXPO_PUBLIC_ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
EXPO_PUBLIC_HOLESKY_RPC_URL=https://holesky.drpc.org
EXPO_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
EXPO_PUBLIC_BSC_RPC_URL=https://bsc-dataseed-public.bnbchain.org
EXPO_PUBLIC_BSC_TESTNET_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
EXPO_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
EXPO_PUBLIC_POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
# Optional. Leave 0/empty for direct public RPC balance reads. Set to 1 only if
# a deployment needs the agent server to proxy wallet balance RPC requests.
EXPO_PUBLIC_WALLET_RPC_PROXY=0
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
HOLESKY_RPC_URL=https://holesky.drpc.org
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BSC_RPC_URL=https://bsc-dataseed-public.bnbchain.org
BSC_TESTNET_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
BASE_RPC_URL=https://mainnet.base.org
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com

# Server-side only. Do not ship this key to the client.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.7

# Server-side only. Used by the local agent server proxy.
BITREFILL_API_KEY=
BITREFILL_API_BASE_URL=https://api.bitrefill.com/v2

# Server-side encrypted web wallet backup storage. The server stores only the
# Token Core encrypted keystore backup, never PRF keys, mnemonics, private keys,
# Google access tokens, RENAISS cookies, or API keys.
WEB_WALLET_BACKUP_DIR=.tmp/web-wallet-backups

# Public Google OAuth web client id for localhost / deployed web origins.
# The Google Cloud OAuth client type must be "Web application".
# Add every app origin to Authorized JavaScript origins, for example:
# - http://localhost:8081
# - http://127.0.0.1:8081
# - https://your-production-domain.com
# Either name works. EXPO_PUBLIC_GOOGLE_CLIENT_ID is bundled by Expo;
# GOOGLE_CLIENT_ID is returned by /api/config at runtime.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Optional later: separate OAuth client id of type "Chrome Extension".
CHROME_EXTENSION_GOOGLE_CLIENT_ID=
CHROME_EXTENSION_PUBLIC_KEY=

# Live RENAISS monitor API used by the agent server proxy.
RENAISS_MONITOR_API_URL=https://renaissmon.zeabur.app
RENAISS_ORIGIN=https://www.renaiss.xyz
RENAISS_CHAIN_ID=56
# Minimum BNB buffer the agent asks users to keep in the RENAISS Safe/app wallet
# before USDT funding, Permit2 approve, and buyNow. This is reviewed and signed
# by the user; it is never transferred automatically.
RENAISS_SAFE_MIN_BNB=0.003

# Local diagnostic only. If omitted, the headless login check uses an ephemeral
# Token Core wallet. Never commit a real mnemonic.
RENAISS_TEST_MNEMONIC=
RENAISS_TEST_PASSWORD=

# Optional: if set, POST /api/renaiss/alerts/webhook requires Bearer token auth.
RENAISS_WEBHOOK_TOKEN=

# Static web export server. ENFORCE_HTTPS=1 should be used behind a proxy that
# sets X-Forwarded-Proto; localhost is never redirected.
WEB_EXPORT_PORT=8091
ENFORCE_HTTPS=0
